# ==== Supabase (publik, aman untuk client) ====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ==== Supabase (server only — JANGAN pakai prefix NEXT_PUBLIC_) ====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key

# ==== Admin allowlist ====
# Satu atau beberapa email, dipisahkan koma. Akun harus dibuat lewat dashboard Supabase.
ADMIN_EMAIL=admin@crawlfast.store
# ADMIN_EMAILS=admin@crawlfast.store,owner@crawlfast.store

# ==== Midtrans ====
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_IS_PRODUCTION=false

# ==== URL publik aplikasi ====
# Dipakai untuk callback pembayaran, sitemap, dan metadata.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==== Rate limit terdistribusi (opsional, wajib untuk Vercel/serverless) ====
# Buat Redis di Vercel Marketplace (Upstash). Tanpa ini, rate limit hanya
# berlaku per instance proses (tidak akurat di serverless).
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
